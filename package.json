{
  "name": "mistr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run public:check && npm run docs:check && npm run test && npm run build && npm run rust:fmt && npm run rust:clippy && npm run rust:test && npm run rust:check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:phase4:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-phase4-packaged.ps1",
    "test:phase5:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-phase5-packaged.ps1",
    "test:phase6:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-phase6-packaged.ps1",
    "test:national:phase2:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-national-phase2-packaged.ps1",
    "test:alpha:readiness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-alpha-readiness-packaged.ps1",
    "test:alpha:soak": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-alpha-live-soak.ps1",
    "test:alpha:installers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-alpha-installer-validation.ps1",
    "test:alpha:sleep-wake": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-alpha-sleep-wake.ps1",
    "test:alpha:clean-machine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-alpha-clean-machine.ps1",
    "env:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/capture-environment.ps1",
    "fixture:download": "node scripts/verify-fixtures.mjs --download",
    "fixture:verify": "node scripts/verify-fixtures.mjs",
    "fixture:verify:phase4": "node scripts/verify-fixtures.mjs --set phase4KtlxReflectivityLoop",
    "fixture:verify:phase6": "node scripts/verify-fixtures.mjs --set phase6N0sCorpus && node scripts/verify-fixtures.mjs --set phase6TlxIemComparison",
    "oracle:n0s": "node scripts/oracle/level3-n0s.mjs",
    "oracle:national": ".oracle-venv\\Scripts\\python.exe scripts/oracle/mrms-national.py",
    "public:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-public-repo.ps1"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "maplibre-gl": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "nexrad-level-3-data": "0.6.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
