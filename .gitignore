*.py[cod]

# Generated Tauri schemas and non-Windows icon variants.
src-tauri/gen/schemas/
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/icon.icns

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
