{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tcurtsinger/Mistr/blob/main/fixtures/manifest.schema.json",
  "title": "Mistr NEXRAD fixture manifest",
  "type": "object",
  "required": ["schemaVersion", "fixtureSets", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "fixtureSets": {
      "type": "object",
      "required": [
        "phase4KtlxReflectivityLoop",
        "phase6N0sCorpus",
        "phase6TlxIemComparison"
      ],
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      },
      "properties": {
        "phase4KtlxReflectivityLoop": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "phase6N0sCorpus": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "phase6TlxIemComparison": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "datasetKind",
          "url",
          "station",
          "observedAt",
          "sizeBytes",
          "sha256",
          "localPath"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "source": { "type": "string", "minLength": 1 },
          "datasetKind": {
            "enum": [
              "level2_archive",
              "level3_n0s",
              "iem_ridge_png",
              "iem_ridge_world_file"
            ]
          },
          "bucket": {
            "enum": ["unidata-nexrad-level2", "unidata-nexrad-level3"]
          },
          "key": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "station": { "type": "string", "pattern": "^[A-Z0-9]{4}$" },
          "observedAt": { "type": "string", "format": "date-time" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "etag": { "type": "string", "minLength": 1 },
          "localPath": { "type": "string", "pattern": "^cache/[A-Za-z0-9_.-]+$" }
        }
      }
    }
  }
}
